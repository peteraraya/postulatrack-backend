# Server
PORT=3000

# Database (PostgreSQL)
# Configura tus credenciales (usuario, contraseña, puerto, base de datos)
DATABASE_URL="postgresql://user:password@localhost:5432/postulatrack?schema=public"

# JWT Authentication
JWT_SECRET="super_secret_jwt_key_please_change"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Frontend URL
FRONTEND_URL="http://localhost:4200"

# Cloudinary (almacenamiento de CVs)
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# Pusher (Real-time WebSockets)
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="your_pusher_cluster"

# AI Providers
GROQ_API_KEY="your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"
OPENROUTER_API_KEY="your_openrouter_api_key"
